<component type="desktop-application">
  <id>io.github.lrash.SystemAudioRecorder</id>
  <name>System Audio Recorder</name>
  <summary>Record system audio output to WAV or Opus</summary>

  <developer id="io.github.lonestarparrot">
    <name>lonestarparrot</name>
  </developer>
  <update_contact>lonestarparrot_AT_gmail.com</update_contact>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <description>
    <p>
      Records what you hear -- the system audio output loopback -- to WAV or
      Opus. Useful for capturing music, streams, or anything else playing
      through your speakers or headphones.
    </p>
    <p>
      Built on GStreamer and GTK, with no FFmpeg and no external recording
      processes. Works with PulseAudio and PipeWire on Linux, and WASAPI
      loopback on Windows.
    </p>
  </description>

  <launchable type="desktop-id">io.github.lrash.SystemAudioRecorder.desktop</launchable>
  <url type="homepage">https://github.com/lrash/system-audio-recorder</url>
  <url type="bugtracker">https://github.com/lrash/system-audio-recorder/issues</url>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>

  <provides>
    <binary>io.github.lrash.SystemAudioRecorder</binary>
  </provides>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.3.0" date="2026-08-15">
      <description><p>Desktop launcher, authorship metadata and signed release.</p></description>
    </release>
    <release version="0.2.1" date="2026-08-15">
      <description><p>Windows handoff fixes.</p></description>
    </release>
    <release version="0.2.0" date="2026-08-15">
      <description><p>Windows WASAPI loopback support and a headless recording engine.</p></description>
    </release>
    <release version="0.1.0" date="2026-08-15">
      <description><p>First release: Linux PulseAudio/PipeWire capture.</p></description>
    </release>
  </releases>
</component>
